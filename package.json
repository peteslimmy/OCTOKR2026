    "dev:seed": "tsx scripts/dev-seed.ts",
    "break-glass:mfa-reset": "tsx scripts/break-glass-mfa-reset.ts",
    "drill:restore": "tsx scripts/backup-restore-drill.ts",
    "perf:baseline": "node scripts/perf-baseline.mjs",
    "dev:totp": "tsx scripts/dev-totp.ts",
    "dev:history": "tsx scripts/dev-history.ts",
    "dev:clock": "tsx scripts/dev-clock.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:api:serial": "node scripts/run-api-tests.mjs",
    "test:e2e": "supabase db reset && npm run dev:seed && playwright test",
    "test:concurrency": "supabase db reset && vitest run --config vitest.concurrency.config.ts"
  },
