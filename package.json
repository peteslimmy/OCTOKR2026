  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:db && npm run test:concurrency",
    "test:unit": "vitest run src",
    "test:db": "supabase db reset && vitest run tests/db",
    "db:start": "supabase start -x imgproxy,edge-runtime,vector,logflare,mailpit,realtime,storage-api,postgres-meta",
    "db:reset": "supabase db reset",
    "db:stop": "supabase stop",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "org:load": "tsx scripts/load-organisation.ts",
    "org:restore": "node scripts/restore-organisation.mjs",
    "admin:add": "tsx scripts/add-super-admin.ts",
