# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# local-only authenticator secrets of seeded elevated users
/.dev-mfa.json

# Playwright
/test-results/
/playwright-report/

# development mail files (EMAIL_TRANSPORT=file)
.dev-mail/

# the filled-in production environment file is a secret
deploy/.env.production

# the organisation's real people and one-time sign-in links (personal data)
/scripts/data/
/.local/

# the generated second Supabase stack used by tests (scripts/test-stack.mjs)
/.test-stack/
/.next-test/
