NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser or commit.
SUPABASE_SERVICE_ROLE_KEY=
# Server-only. Keys the hash of emailed one-time passcodes (at least 32 characters). Keep it stable: changing it
# invalidates codes already in flight. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_EMAIL_PEPPER=
# Direct DB URL: used only by the test suite and ops scripts.
DB_URL=
# Shared secret for POST /api/internal/jobs/run (scheduler). Use a long random value.
JOBS_SECRET=
# During a secret rotation only: the value being retired. Both work; remove it once the scheduler uses the new one.
JOBS_SECRET_PREVIOUS=
# Where sign-in attempt counts are kept: "database" (shared by every instance, the default in production) or "memory" (per instance, the default elsewhere).
RATE_LIMIT_STORE=
# Email channel (optional; the provider is an open decision). With none set, mail is queued for 48 hours and then dropped; reminders still appear in the app.
#   EMAIL_TRANSPORT=smtp  with SMTP_URL=smtps://user:password@smtp.example.com:465  and EMAIL_FROM="4CORE-OKR <no-reply@your-domain>"
#   EMAIL_TRANSPORT=file  with EMAIL_FILE_DIR=.dev-mail   (development and tests only: one .json file per mail; ignored in production)
EMAIL_TRANSPORT=
SMTP_URL=
EMAIL_FROM=
EMAIL_FILE_DIR=
# Public address of the application, used for the link in emails.
APP_BASE_URL=

# Integrations (Administration -> Integrations): passwords and API keys entered there are encrypted with this key before they are stored.
# 32 random bytes, base64:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it in the host's secret store. Losing it loses only those secrets (they are typed in again). Rotation: docs/27 section 3d.
INTEGRATIONS_ENCRYPTION_KEY=
# During a key rotation only: the key being retired (comma-separated if more than one).
INTEGRATIONS_ENCRYPTION_KEY_PREVIOUS=
# Development and automated tests only: lets integrations point at addresses inside your network (127.0.0.1, 10.x ...). Never set this in production.
# INTEGRATIONS_ALLOW_PRIVATE_HOSTS=true

# Prometheus scrape token for /api/metrics (required in production; the endpoint answers 401 without it)
METRICS_TOKEN=
